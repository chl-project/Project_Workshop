# Copy to .env.local for local `vercel dev`, and set the same values in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.

# --- Neon (Postgres) -------------------------------------------------------
# Provided automatically by the Vercel Neon integration. Any one of these works;
# DATABASE_URL is the one the code prefers.
DATABASE_URL=

# --- Vercel Blob -----------------------------------------------------------
# Provided automatically by the Vercel Blob integration.
BLOB_READ_WRITE_TOKEN=

# --- API key ---------------------------------------------------------------
# Shared secret that authorizes write operations (seeding + uploads).
# If left empty, writes are open (fine for a first deploy).
# Server-side value:
API_KEY=
# Public value the browser sends with writes — set it to the SAME string as
# API_KEY so the frontend is allowed to seed and upload. Exposed in the client
# bundle (this is a workshop shared secret, not per-user auth).
VITE_API_KEY=

# --- AI (Value Engineering suggestions) ------------------------------------
# OpenAI API key that powers the "Minta usulan VE dari AI" button.
# If unset, that button reports that AI is not configured (everything else
# still works).
OPENAI_API_KEY=
# Optional — defaults to gpt-4o. Set this if your account uses another model.
OPENAI_MODEL=
# Optional — embedding model for the knowledge base. Defaults to
# text-embedding-3-small. Changing it after documents are indexed means the old
# embeddings no longer compare correctly; re-upload the documents if you do.
OPENAI_EMBED_MODEL=
